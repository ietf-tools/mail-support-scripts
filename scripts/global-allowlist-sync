#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["httpx", "psycopg[binary]", "mailmanclient"]
# ///
"""
Sync global allowlist to Mailman and Postconfirm.

This script maintains the single source of truth for "known good senders":
1. Fetches active emails from Datatracker API
2. Fetches all Mailman subscribers + accept_these_nonmembers
3. Syncs combined list to global-whitelist@ietf.org Mailman list
4. Syncs to postconfirm's senders_static table

Usage:
    ./global-allowlist-sync                    # dry-run, show what would change
    ./global-allowlist-sync --apply            # apply changes
    ./global-allowlist-sync --apply --verbose  # apply with detailed output
"""

import argparse
import logging
import os
import re
from typing import Optional

import httpx
import mailmanclient
import psycopg

DATATRACKER_URL = os.environ.get("DATATRACKER_URL", "https://datatracker.ietf.org")
DATATRACKER_TOKEN = os.environ.get("DATATRACKER_TOKEN")

MAILMAN_API_URL = os.environ.get("MAILMAN_API_URL")
MAILMAN_API_USER = os.environ.get("MAILMAN_API_USER")
MAILMAN_API_PASSWORD = os.environ.get("MAILMAN_API_PASSWORD")

GLOBAL_ALLOWLIST_FQDN = os.environ.get("GLOBAL_ALLOWLIST_FQDN", "global-whitelist@ietf.org")

POSTCONFIRM_DB_HOST = os.environ.get("POSTCONFIRM_DB_HOST", "db-rw")
POSTCONFIRM_DB_PORT = os.environ.get("POSTCONFIRM_DB_PORT", "5432")
POSTCONFIRM_DB_NAME = os.environ.get("POSTCONFIRM_DB_NAME", "postconfirm")
POSTCONFIRM_DB_USER = os.environ.get("POSTCONFIRM_DB_USER")
POSTCONFIRM_DB_PASS = os.environ.get("POSTCONFIRM_DB_PASS")

logger = logging.getLogger(__name__)


def cleanup_email(val: str) -> Optional[str]:
    val = val.strip().lower()
    if val.startswith("^") or val.startswith('"'):
        val = val[1:]
    if val.endswith("$") or val.endswith(",") or val.endswith('"'):
        val = val[:-1]
    if re.search(r"@.*@$", val):
        val = val[:-1]
    if " " in val:
        val = val[: val.find(" ")]
    return val


def should_ignore(val: str) -> bool:
    return (
        val.startswith("@")
        or val.endswith(".")
        or val.startswith(".*")
        or ("@." in val)
        or ("@.*" in val)
        or re.search(r"@.*/", val) is not None
        or re.search(r'[,"\[\]]', val) is not None
        or not re.search(r"@.+\.", val)
        or val.startswith("by:")
        or val.startswith("mailto:")
        or val.endswith(";")
        or not val.isascii()
    )


def fetch_datatracker_emails() -> set[str]:
    logger.info("fetching active emails from datatracker...")
    url = f"{DATATRACKER_URL}/api/person/email/"
    headers = {"X-Api-Key": DATATRACKER_TOKEN} if DATATRACKER_TOKEN else {}

    if not DATATRACKER_TOKEN:
        logger.warning("DATATRACKER_TOKEN not set")

    resp = httpx.get(url, headers=headers, timeout=120)
    resp.raise_for_status()

    emails = set()
    for addr in resp.json().get("addresses", []):
        cleaned = cleanup_email(addr)
        if cleaned and not should_ignore(cleaned):
            emails.add(cleaned)

    logger.debug("got %d emails from datatracker", len(emails))
    return emails


class MailmanClient:
    def __init__(self):
        self._client = None

    @property
    def client(self):
        if self._client is None:
            self._client = mailmanclient.Client(
                MAILMAN_API_URL,
                MAILMAN_API_USER,
                MAILMAN_API_PASSWORD,
            )
        return self._client

    def get_all_subscriber_emails(self) -> set[str]:
        logger.info("fetching all mailman subscribers...")
        emails = set()
        for mlist in self.client.lists:
            if mlist.fqdn_listname == GLOBAL_ALLOWLIST_FQDN:
                continue
            if re.match(r"^\d+all@", mlist.fqdn_listname):
                continue

            page = mlist.get_member_page(count=10000, page=1)
            while True:
                for member in page:
                    cleaned = cleanup_email(member.email)
                    if cleaned and not should_ignore(cleaned):
                        emails.add(cleaned)
                if page.has_next:
                    page = page.next
                else:
                    break

        logger.debug("got %d subscriber emails from mailman", len(emails))
        return emails

    def get_accept_these_nonmembers(self) -> set[str]:
        logger.info("fetching accept_these_nonmembers from all lists...")
        emails = set()
        for mlist in self.client.lists:
            for val in mlist.settings.get("accept_these_nonmembers", []):
                cleaned = cleanup_email(val)
                if cleaned and not should_ignore(cleaned):
                    emails.add(cleaned)

        logger.debug("got %d accept_these_nonmembers entries", len(emails))
        return emails

    def get_global_allowlist(self):
        for mlist in self.client.lists:
            if mlist.fqdn_listname == GLOBAL_ALLOWLIST_FQDN:
                return mlist
        raise RuntimeError(f"Cannot find {GLOBAL_ALLOWLIST_FQDN}")

    def get_global_allowlist_members(self) -> set[str]:
        mlist = self.get_global_allowlist()
        members = set()
        page = mlist.get_member_page(count=10000, page=1)
        while True:
            for member in page:
                members.add(member.email.lower())
            if page.has_next:
                page = page.next
            else:
                break
        return members

    def sync_global_allowlist(self, addresses: set[str], apply: bool) -> tuple[int, int]:
        mlist = self.get_global_allowlist()
        existing = self.get_global_allowlist_members()

        to_add = addresses - existing
        to_remove = existing - addresses

        logger.info("global-whitelist: %d to add, %d to remove", len(to_add), len(to_remove))

        if not apply:
            return len(to_add), len(to_remove)

        for addr in to_remove:
            try:
                mlist.unsubscribe(addr, pre_confirmed=True, pre_approved=True)
                logger.debug("unsubscribed %s", addr)
            except Exception as e:
                logger.error("error unsubscribing %s: %s", addr, e)

        for addr in to_add:
            try:
                mlist.subscribe(addr, pre_verified=True, pre_confirmed=True, pre_approved=True)
                logger.debug("subscribed %s", addr)
            except Exception as e:
                logger.error("error subscribing %s: %s", addr, e)

        return len(to_add), len(to_remove)


def get_postconfirm_db_connection():
    conninfo = f"host={POSTCONFIRM_DB_HOST} port={POSTCONFIRM_DB_PORT} dbname={POSTCONFIRM_DB_NAME} user={POSTCONFIRM_DB_USER} password={POSTCONFIRM_DB_PASS}"
    return psycopg.connect(conninfo)


def fetch_never_allow_addresses() -> set[str]:
    """
    Fetch addresses that should never be added to the allowlist.
    These are stored in the postconfirm database's never_allow table.
    """
    logger.info("fetching never-allow addresses from postconfirm db...")
    try:
        with get_postconfirm_db_connection() as conn:
            with conn.cursor() as cur:
                cur.execute("SELECT email FROM never_allow")
                addresses = {row[0].lower() for row in cur.fetchall()}
        logger.debug("got %d never-allow addresses", len(addresses))
        return addresses
    except Exception as e:
        logger.warning("could not fetch never-allow addresses: %s", e)
        logger.warning("falling back to hardcoded defaults")
        return {
            "iab@iab.org",
            "iab@ietf.org",
            "iesg@ietf.org",
        }


def sync_postconfirm_senders_static(addresses: set[str], apply: bool) -> tuple[int, int, int]:
    logger.info("syncing to postconfirm senders_static...")

    with get_postconfirm_db_connection() as conn:
        with conn.cursor() as cur:
            cur.execute(
                "SELECT sender FROM senders_static WHERE source = 'global-allowlist' AND type = 'E'"
            )
            existing = {row[0] for row in cur.fetchall()}

        to_add = addresses - existing
        to_remove = existing - addresses

        logger.info("postconfirm senders_static: %d to add, %d to remove", len(to_add), len(to_remove))

        if not apply:
            return len(to_add), len(to_remove), len(existing)

        with conn.transaction():
            with conn.cursor() as cur:
                for addr in to_remove:
                    cur.execute(
                        "DELETE FROM senders_static WHERE sender = %s AND source = 'global-allowlist'",
                        (addr,)
                    )

                for addr in to_add:
                    cur.execute(
                        """
                        INSERT INTO senders_static (sender, action, source, type)
                        VALUES (%s, 'accept', 'global-allowlist', 'E')
                        ON CONFLICT (sender) DO UPDATE SET action = 'accept', source = 'global-allowlist'
                        """,
                        (addr,)
                    )

        return len(to_add), len(to_remove), len(existing)


def main():
    parser = argparse.ArgumentParser(
        description="Sync global allowlist to Mailman and Postconfirm",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__
    )
    parser.add_argument("--apply", action="store_true", help="Apply changes (default is dry-run)")
    parser.add_argument("--verbose", "-v", action="store_true", help="Verbose output")
    parser.add_argument("--skip-mailman", action="store_true", help="Skip Mailman sync")
    parser.add_argument("--skip-postconfirm", action="store_true", help="Skip Postconfirm sync")
    parser.add_argument("--skip-datatracker", action="store_true", help="Skip Datatracker fetch (use Mailman only)")
    args = parser.parse_args()

    logging.basicConfig(
        format="%(levelname)s: %(message)s",
        level=logging.DEBUG if args.verbose else logging.INFO,
    )

    if not args.apply:
        logger.info("DRY RUN - no changes will be made (use --apply to apply)")

    addresses = set()

    if not args.skip_datatracker:
        addresses |= fetch_datatracker_emails()

    mm = MailmanClient()

    if not args.skip_mailman or not args.skip_postconfirm:
        addresses |= mm.get_all_subscriber_emails()
        addresses |= mm.get_accept_these_nonmembers()

    never_allow = fetch_never_allow_addresses()
    addresses -= never_allow

    logger.info("total unique addresses: %d", len(addresses))

    if not args.skip_mailman:
        mm.sync_global_allowlist(addresses, apply=args.apply)

    if not args.skip_postconfirm:
        sync_postconfirm_senders_static(addresses, apply=args.apply)

    if args.apply:
        logger.info("sync complete")
    else:
        logger.info("dry run complete - use --apply to make changes")


if __name__ == "__main__":
    main()
